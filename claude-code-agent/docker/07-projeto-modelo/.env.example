# Copie para .env antes de subir:   cp .env.example .env
#
# O arquivo .env NÃO vai para o Git (está no .gitignore) nem para a imagem (está no
# .dockerignore). Isso é intencional: segredo não pertence a nenhum dos dois.
#
# Em produção de verdade, nem .env se usa — o valor vem do gerenciador de segredos da
# plataforma (Docker Secrets, Vault, AWS Secrets Manager, Kubernetes Secret).

# Obrigatória: sem ela, `docker compose up` aborta com mensagem explícita.
NOME_DO_MURAL=Mural do Homelab

# Porta em que o proxy escuta NA SUA MÁQUINA (só no loopback).
PORTA_PUBLICA=8080

# Quantos recados o mural guarda antes de descartar os mais antigos.
MAX_RECADOS=500
