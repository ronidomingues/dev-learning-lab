/// Modelo semântico "Tintas Aurora".
/// Arquivo raiz da definição: cultura, opções e a lista de referências.
model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

	/// DECISÃO: data/hora automática DESLIGADA.
	/// Quando ligada, o Power BI cria uma tabela de datas OCULTA para cada
	/// coluna de data do modelo (aqui seriam duas: Data e DataEntrega).
	/// Isso infla o arquivo, duplica hierarquias e confunde o usuário.
	/// Temos dCalendario própria; a automática só atrapalha.
	discourageImplicitMeasures

annotation __PBI_TimeIntelligenceEnabled = 0

ref table dCalendario
ref table dMes
ref table dProduto
ref table dCliente
ref table dVendedor
ref table dSeguranca
ref table fVendas
ref table fMetas
ref table _Medidas

ref role VendasRestritas
