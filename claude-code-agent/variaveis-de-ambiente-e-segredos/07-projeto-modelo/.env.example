# ═══════════════════════════════════════════════════════════════════════
#  Cofre de Recados — contrato de configuração
#
#  Este arquivo É versionado. Ele documenta QUAIS variáveis existem.
#  O .env com os VALORES nunca é versionado.
#
#  Uso:  cp .env.example .env   e preencha.
#  Confira:  npm run check-config
# ═══════════════════════════════════════════════════════════════════════

# ─── OBRIGATÓRIAS ──────────────────────────────────────────────────────

# Banco de dados. Esquemas aceitos: postgres, postgresql, memory.
# Em desenvolvimento pode usar memory://local (dados somem ao reiniciar).
# Formato: postgres://usuario:senha@host:porta/banco
DATABASE_URL=memory://local

# Segredo de assinatura. Mínimo 32 caracteres.
# Gere o seu com:  openssl rand -base64 48
# ⚠️ O valor abaixo é RECUSADO quando NODE_ENV=production.
SESSION_SECRET=desenvolvimento-apenas-troque-isto-em-producao

# Chave de acesso à API (cabeçalho Authorization: Bearer <chave>).
# Chaves sk_test_… são recusadas quando NODE_ENV=production.
API_KEY=sk_test_troque_esta_chave

# ─── OPCIONAIS (o padrão está entre colchetes) ─────────────────────────

NODE_ENV=            # [development] um de: development, test, production
PORT=                # [3000]  inteiro de 1 a 65535
LOG_LEVEL=           # [info]   um de: debug, info, warn, error
MAX_RECADOS=         # [100]    inteiro de 1 a 100000
EXPOR_METRICAS=      # [false]  "true" ou "false" — expõe a rota /metrics

# ─── VARIANTE _FILE (produção com Docker/Kubernetes) ───────────────────
# Toda variável acima aceita o sufixo _FILE apontando para um arquivo
# cujo conteúdo é o valor. O sufixo TEM PRECEDÊNCIA sobre a variável.
#
#   DATABASE_URL_FILE=/run/secrets/database_url
#   SESSION_SECRET_FILE=/run/secrets/session_secret
#   API_KEY_FILE=/run/secrets/api_key
