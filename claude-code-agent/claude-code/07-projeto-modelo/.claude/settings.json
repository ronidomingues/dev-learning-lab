{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run verificar)",
      "Bash(node --test)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Read(./**)",
      "Edit(./src/**)",
      "Edit(./test/**)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Bash(curl *)",
      "Bash(npm install *)",
      "Bash(rm -rf *)"
    ]
  },

  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/contexto-da-sessao.sh",
            "args": [],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/bloqueia-segredos.sh",
            "args": [],
            "timeout": 10,
            "statusMessage": "conferindo se o arquivo é protegido"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/testa-apos-edicao.sh",
            "args": [],
            "timeout": 120,
            "statusMessage": "rodando a suíte de testes"
          }
        ]
      }
    ]
  }
}
