    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "cond-achou", "leftValue": "={{ $json.pedido_id }}", "rightValue": "", "operator": { "type": "string", "operation": "exists", "singleValue": true } }
