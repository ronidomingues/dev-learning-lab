{
  "id": "cp03relatoriodia",
  "name": "CP · 03 Relatorio diario",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "cronExpression", "expression": "0 7 * * *" } ] }
      },
      "id": "cp030000-0000-0000-0000-000000000001",
      "name": "Todo dia as 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-200, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT cliente,\n       COUNT(*)          AS pedidos,\n       SUM(valor)::float AS total\nFROM pedidos\nWHERE recebido_em >= NOW() - INTERVAL '24 hours'\nGROUP BY cliente\nORDER BY total DESC;",
        "options": {}
      },
      "id": "cp030000-0000-0000-0000-000000000002",
      "name": "Vendas das ultimas 24h",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [40, 0],
      "alwaysOutputData": true,
      "credentials": { "postgres": { "id": "cpcredpostgres001", "name": "Postgres central-de-pedidos" } }
    },
    {
      "parameters": {
        "jsCode": "// Se nao houve pedido nenhum, o no anterior devolve um item vazio\n// (por causa de alwaysOutputData). Trate isso de forma explicita.\nconst linhas = $input.all().map(i => i.json).filter(l => l && l.cliente);\nif (linhas.length === 0) {\n  return [{ json: { cliente: '(sem pedidos nas ultimas 24h)', pedidos: 0, total: 0 } }];\n}\nreturn linhas.map(l => ({ json: l }));"
      },
      "id": "cp030000-0000-0000-0000-000000000003",
      "name": "Tratar relatorio vazio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 0]
    },
    {
      "parameters": { "operation": "csv", "options": { "fileName": "relatorio.csv" } },
      "id": "cp030000-0000-0000-0000-000000000004",
      "name": "Gerar CSV",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [480, 0]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/files/relatorio-{{ $now.toFormat('yyyy-LL-dd') }}.csv",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "cp030000-0000-0000-0000-000000000005",
      "name": "Gravar em /files",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [700, 0]
    }
  ],
  "connections": {
    "Todo dia as 07:00": { "main": [[{ "node": "Vendas das ultimas 24h", "type": "main", "index": 0 }]] },
    "Vendas das ultimas 24h": { "main": [[{ "node": "Tratar relatorio vazio", "type": "main", "index": 0 }]] },
    "Tratar relatorio vazio": { "main": [[{ "node": "Gerar CSV", "type": "main", "index": 0 }]] },
    "Gerar CSV": { "main": [[{ "node": "Gravar em /files", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "America/Sao_Paulo" }
}
