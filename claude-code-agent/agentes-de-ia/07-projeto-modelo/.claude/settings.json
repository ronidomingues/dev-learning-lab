{
  "permissions": {
    "allow": [
      "Bash(python3 teste_mcp.py)",
      "Bash(git status)",
      "Bash(git diff:*)"
    ],
    "deny": [
      "Read(./tarefas.db)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && python3 teste_mcp.py"
          }
        ]
      }
    ]
  }
}
