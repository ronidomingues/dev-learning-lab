# Copie para .env e ajuste. NUNCA comite o .env (já está no .gitignore).
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Rate limit: quantas requisições por identidade, em qual janela.
RATE_LIMIT=100
RATE_LIMIT_JANELA_MS=60000

# Limite do corpo da requisição, em bytes. Sem isto, um POST gigante derruba o processo.
LIMITE_CORPO_BYTES=262144

# Tokens de produção. Formato: token:identidade:escopo1|escopo2,token2:...
# Em NODE_ENV=production os tokens de demonstração NÃO existem — esta variável
# passa a ser a única fonte, e sem ela ninguém autentica.
# API_TOKENS=tok_abc123:servico-relatorios:livros:ler|emprestimos:ler
