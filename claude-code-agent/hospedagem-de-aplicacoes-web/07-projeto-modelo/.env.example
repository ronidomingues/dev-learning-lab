# Copie para .env e preencha. NUNCA versione o .env.
# Sem estas duas variáveis a aplicação sobe em MODO MEMÓRIA (útil para testes e demonstração).

# PostgreSQL — Neon, Supabase, Render, ou o container local do compose.yaml
DATABASE_URL=postgresql://app:dev_senha_local@localhost:5432/app

# Redis/Valkey — Upstash (rediss://) ou o container local
REDIS_URL=redis://localhost:6379

# Porta em que o servidor escuta. A plataforma sobrescreve isto.
PORT=3000

# Base pública usada para montar a URL curta devolvida pela API
BASE_URL=http://localhost:3000

# Limite de criação de links por IP (janela fixa)
RATE_LIMITE=20
RATE_JANELA_MS=60000
