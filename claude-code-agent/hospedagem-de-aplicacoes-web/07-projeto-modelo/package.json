{
  "name": "encurtalink",
  "version": "1.0.0",
  "description": "Projeto-modelo do curso de hospedagem: encurtador de URLs com PostgreSQL, Redis e frontend estático",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/migrate.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:integracao": "INTEGRACAO=1 node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "ioredis": "^5.4.1",
    "pg": "^8.13.1"
  },
  "license": "MIT"
}
