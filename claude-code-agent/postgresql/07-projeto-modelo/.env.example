# Copie para .env antes de subir:  cp .env.example .env
# O arquivo .env não vai para o Git.

# Senha do PostgreSQL. Obrigatória: o compose aborta sem ela.
DB_SENHA=troque-esta-senha

# Para conectar da SUA máquina (psql/DBeaver) ao banco do compose:
#   psql "postgres://biblioteca:troque-esta-senha@localhost:5432/biblioteca"
