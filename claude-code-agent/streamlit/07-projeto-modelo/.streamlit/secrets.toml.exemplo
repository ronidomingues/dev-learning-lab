# Copie para .streamlit/secrets.toml e preencha. NUNCA versione secrets.toml.
# Leia com st.secrets["banco"]["senha"].

[banco]
url = "postgresql+psycopg://usuario:senha@host:5432/base"

# Bloco usado por st.login() (OIDC). Ver 22-autenticacao-e-autorizacao.md.
[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "troque-por-32-bytes-aleatorios-de-verdade"

[auth.google]
client_id = "xxxx.apps.googleusercontent.com"
client_secret = "xxxx"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
