<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Horas_Obrigatorias_Ao_Concluir</fullName>
    <active>true</active>
    <description>Não se conclui uma OS sem registrar as horas gastas.</description>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, "Concluida"),
  OR(
    ISBLANK(Horas_Gastas__c),
    Horas_Gastas__c &lt;= 0
  )
)</errorConditionFormula>
    <errorDisplayField>Horas_Gastas__c</errorDisplayField>
    <errorMessage>Informe as horas gastas (maior que zero) para concluir a ordem de serviço.</errorMessage>
</ValidationRule>
